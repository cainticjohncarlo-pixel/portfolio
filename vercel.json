{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.johncarloofficial.com" }],
      "destination": "https://johncarloofficial.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.johncarloofficial.com" }],
      "destination": "https://johncarloofficial.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)?$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
